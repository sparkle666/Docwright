+.th-script-line-text { color: var(--ink); line-height: 1.5; }
+
+/* ── Pause / Stop controls ───────────────────────────────────────────── */
+.th-control-actions {
+  display: flex;
+  gap: 8px;
+  flex-wrap: wrap;
+  margin-bottom: 8px;
+}
