+.th-script-count {
+  flex-shrink: 0;
+  font-size: 0.78rem;
+  font-variant-numeric: tabular-nums;
+  color: var(--slate-soft);
+  background: var(--surface-sunken, var(--surface));
+  border: 1px solid var(--line-strong);
+  border-radius: 20px;
+  padding: 3px 10px;
+  white-space: nowrap;
+  align-self: center;
+}
+
+.th-script-list {
+  max-height: 360px;
+  overflow-y: auto;
+}
+
+.th-script-line {
+  padding: 10px 18px;
+  border-bottom: 1px solid var(--line-subtle, var(--line-strong));
+  font-size: 0.88rem;
+}
+
+.th-script-line:last-child { border-bottom: none; }
+
+.th-script-line-meta {
+  display: flex;
+  gap: 10px;
+  font-size: 0.75rem;
+  color: var(--slate-soft);
+  margin-bottom: 4px;
+}
