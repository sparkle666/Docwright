 client/src/pages/TalkingHeadPage.jsx | 113 +++++++++++++++++++++++---
 client/src/pages/VoiceOverPage.css   |  98 ++++++++++++++++++++++
 client/src/pages/VoiceOverPage.jsx   |  13 ++-
 4 files changed, 330 insertions(+), 10 deletions(-)

