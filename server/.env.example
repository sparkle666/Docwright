# Copy this file to .env and fill in your own values.

# ─── Required ────────────────────────────────────────────────────────────────

# Your OpenAI API key (needs access to Whisper, GPT-4o, and GPT-4o Vision)
OPENAI_API_KEY=sk-your-key
# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Express server listens on
PORT=4000

# ─── File uploads ────────────────────────────────────────────────────────────

# Max upload size in MB for source videos (applies to both Multer and Express body parser)
MAX_UPLOAD_MB=9024

# ─── AI models ───────────────────────────────────────────────────────────────

# Whisper model for transcription
WHISPER_MODEL=whisper-1

# GPT model for transcript → structured doc writing
TEXT_MODEL=gpt-5.5

# GPT model for screenshot frame selection (must support vision)
VISION_MODEL=gpt-4o

# Audio model for the AI voice-over feature (must support audio in/out via
# Chat Completions — see /api/voices for the list of supported voices)
TTS_MODEL=gpt-audio-1.5

# Default voice for the AI voice-over feature; can be overridden per-request
TTS_VOICE=alloy

# ─── Pipeline tuning ─────────────────────────────────────────────────────────

# Max candidate frames sent to GPT-4 Vision per step
MAX_CANDIDATE_FRAMES_PER_STEP=6

# ffmpeg scene-change sensitivity (0.0 – 1.0). Lower = more frames detected.
SCENE_CHANGE_THRESHOLD=0.12

# In addition to scene-change detection, also sample one frame every N seconds.
# This catches mid-action UI states that scene-change detection misses (it tends
# to fire mid-transition — cursor mid-click, fade in/out, partially rendered UI).
FRAME_INTERVAL_SECONDS=3

# Minimum Laplacian variance for a frame to be considered "sharp" and kept as a
# Vision candidate. Blurry/motion-blurred frames below this are discarded before
# ever reaching the Vision API (no extra cost — pure ffmpeg/sharp check).
# Typical sharp UI screenshot: 800-2000. Motion blur: 20-80. Partially loaded: 100-200.
SHARPNESS_THRESHOLD=150

# Timeout in seconds for each ffmpeg/ffprobe subprocess (0 = no limit)
FFMPEG_TIMEOUT_SECONDS=600

# ─── Rate limiting ────────────────────────────────────────────────────────────

# Max upload+process requests per IP per window (set to 0 to disable)
RATE_LIMIT_MAX=20
# Window duration in minutes
RATE_LIMIT_WINDOW_MINUTES=60

# ─── Optional webhook ────────────────────────────────────────────────────────

# If set, the server POSTs a JSON payload to this URL when a project completes or fails
# WEBHOOK_URL=https://your-service.example.com/hooks/docwright
